<!doctype html>
<html lang="en" class="h-100" data-bs-theme="auto">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Simple Socmed">
    <meta name="author" content="Catherine NSH">
    <title>Simple Socmed - Beranda</title>
    <link rel="icon" href="/gambar/teh poci.png">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.css">
    <link rel="stylesheet" href="/custom/sign-in.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <script src="/fontawesome/js/all.js"></script>
    <script>src = "/bootstrap/js/bootstrap.js"</script>
</head>

<body>
    <main class="form-signin w-100">

        <form action="/proses-signup" method="post" class="wrapper">
            <!-- <img class="mb-4" src="/gambar/teh poci.png" alt="" height="50"> -->
            <h1 class="h3 mb-3 fw-normal fs-36px "><strong>Daftar</strong></h1>
            <% if (message) { %>
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <%= (message)  %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                  </div> 
            <% } %>

            <div class="form-floating" >
                <input type="text" id="nama_lengkap" name="form_namalengkap" class="form-control" placeholder="Nama Lengkap"  required>
                <label >Nama Lengkap</label>
            </div>

            <div class="form-floating" >
                <input type="text" id="username" name="form_username" class="form-control" placeholder="name@example.com" required>
                <label for="floatingInput" >Username</label>
                <i class='bx bxs-user'></i>
            </div>

            <div class="form-floating" >
                <input type="password" id="password" name="form_password" class="form-control" placeholder="Password"required>
                <label>Password</label>
                <i class='bx bxs-lock-alt' ></i>
            </div>

            <div>
                <button class="btn btn-primary w-100 py-2" type="submit">Sign Up</button>
            </div>
            <a href="/login" class="text-white text-decoration-none">
                <i class="fa-solid fa-reply mt-3"></i> kembali
            </a>
        </form>

    </main>
</body>

</html>